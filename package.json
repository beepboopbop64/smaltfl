{
  "name": "smaltfl",
  "version": "0.1.0",
  "private": true,
  "description": "Data pipelines for smaltdb: flows built visually, run in the browser, hashed all the way through",
  "keywords": [
    "smaltdb",
    "pipelines",
    "data-engineering",
    "lineage",
    "reproducibility"
  ],
  "homepage": "https://github.com/beepboopbop64/smaltfl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beepboopbop64/smaltfl.git"
  },
  "bugs": {
    "url": "https://github.com/beepboopbop64/smaltfl/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "deps": "node scripts/fetch-packed.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/fetch-packed.mjs --check && tsc -p tsconfig.json",
    "test": "node scripts/fetch-packed.mjs --check && vitest run",
    "check": "npm run typecheck && npm test",
    "bench": "node scripts/fetch-packed.mjs --check && SMALTFL_BENCH=1 vitest run"
  },
  "peerDependencies": {
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "smaltdb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
